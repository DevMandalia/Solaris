filters:
  and:
    - file.inFolder("Board/Tasks")
    - type == "task"
formulas:
  priority_rank: if(priority == "P0", 0, if(priority == "P1", 1, if(priority == "P2", 2, if(priority == "P3", 3, 4))))
properties:
  title:
    displayName: Task
  lane:
    displayName: Lane
  project:
    displayName: Epic
  priority:
    displayName: Priority
  kanban_order:
    displayName: Order
  sprint:
    displayName: Sprint
  carry:
    displayName: Carry
  phase:
    displayName: Phase
  agent_id:
    displayName: Agent
  plan_id:
    displayName: Plan
  source:
    displayName: Source
  updated:
    displayName: Updated
views:
  - type: kanban
    name: Home
    filters:
      and:
        - lane != "archived"
        - lane != "triage"
        - phase != "icebox"
        - or:
            - lane != "done"
            - sprint == "2026-W31"
    groupBy:
      property: lane
      direction: ASC
    order:
      - kanban_order
      - title
    cardTitleProperty: note.title
    boardColumns:
      - backlog
      - doing this week
      - in progress now
      - blocked
      - done
  - type: kanban
    name: Flow
    filters:
      and:
        - lane != "archived"
        - lane != "triage"
        - phase != "icebox"
        - or:
            - lane != "done"
            - sprint == "2026-W31"
    groupBy:
      property: lane
      direction: ASC
    order:
      - kanban_order
      - title
    cardTitleProperty: note.title
    boardColumns:
      - backlog
      - doing this week
      - in progress now
      - blocked
      - done
  - type: table
    name: Triage
    filters:
      and:
        - lane == "triage"
    order:
      - updated
      - title
  - type: table
    name: Carried over
    filters:
      and:
        - carry == true
        - lane != "done"
        - lane != "archived"
    order:
      - kanban_order
      - title
  - type: table
    name: Blocked aging
    filters:
      and:
        - lane == "blocked"
    order:
      - updated
      - title
  - type: table
    name: All open
    filters:
      and:
        - lane != "done"
        - lane != "archived"
    order:
      - carry
      - kanban_order
      - title
  - type: kanban
    name: Agent work
    filters:
      and:
        - source == "agent"
        - lane != "archived"
    groupBy:
      property: lane
      direction: ASC
    order:
      - kanban_order
      - title
    cardTitleProperty: note.title
    boardColumns:
      - todo
      - in-progress
      - blocked
      - done
  - type: kanban
    name: By agent
    filters:
      and:
        - source == "agent"
        - lane != "done"
        - lane != "archived"
    groupBy:
      property: agent_id
      direction: ASC
    order:
      - kanban_order
      - title
    cardTitleProperty: note.title
  - type: table
    name: Done
    filters:
      and:
        - lane == "done"
    order:
      - updated
    orderDirection: DESC
